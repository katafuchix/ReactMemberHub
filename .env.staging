# Vite build mode: staging (npm run build:staging)

# ---- server ----
PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/react-member-hub
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d
# カンマ区切りで複数指定可。ネイティブ (Capacitor) からのアクセスを許可するには
# capacitor://localhost (iOS) と https://localhost (Android) を追加する。
CLIENT_ORIGIN=http://localhost:5173,capacitor://localhost,https://localhost

# ---- メール認証 (Resend) ----
# RESEND_API_KEY 未設定なら確認コードはサーバーのコンソールに出力される。
RESEND_API_KEY=
# 検証済みドメインのアドレス推奨。onboarding@resend.dev は Resend 登録アドレス宛のみ配送。
RESEND_FROM_EMAIL=Member Hub <onboarding@resend.dev>
EMAIL_VERIFICATION_TTL_MIN=60

# ---- client (Vite) ----
# Web 開発時は不要 (vite.config.ts の proxy 経由で /api に転送)。
# ネイティブビルドでは絶対URL必須。環境別に .env.staging / .env.production で設定する。
#   npm run build:staging   -> .env.staging の VITE_API_BASE_URL
#   npm run build:production -> .env.production の VITE_API_BASE_URL

VITE_API_BASE_URL=http://localhost:8000/api

# ネイティブアプリは Vite proxy が無いため API の絶対URLが必須。
#VITE_API_BASE_URL=https://api-stg.example.com/api
