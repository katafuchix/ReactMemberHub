# このファイルを .env にコピーして使う (repo ルートに置く)
#   cp .env.example .env

# ---- server ----
PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/react-member-hub
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# ---- メール認証 (Resend) ----
# RESEND_API_KEY 未設定なら確認コードはサーバーのコンソールに出力される。
RESEND_API_KEY=
# 検証済みドメインのアドレス推奨。onboarding@resend.dev は Resend 登録アドレス宛のみ配送。
RESEND_FROM_EMAIL=Member Hub <onboarding@resend.dev>
EMAIL_VERIFICATION_TTL_MIN=60

# ---- client (Vite) ----
# 通常は不要。API は vite.config.ts の proxy 経由で /api に転送される。
# VITE_API_BASE_URL=/api
