# このファイルを .env にコピーして使う (repo ルートに置く)
#   cp .env.example .env

# ---- server ----
PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/react-member-hub
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# ---- client (Vite) ----
# 通常は不要。API は vite.config.ts の proxy 経由で /api に転送される。
# VITE_API_BASE_URL=/api
